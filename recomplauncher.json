{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Deception IV: The Nightmare Princess",
  "repo": "rcostanza/Deception-IV-NightmarePrincess-recomp",
  "game": {
    "kind": "folder",
    "label": "Your decrypted dump of the PS4 game (CUSA02859): the folder with eboot.bin, sce_module, sce_sys and FILE_PS4. Keep its update (1.01) next to it as <folder>-patch, as shadPS4 does, and it is used too.",
    "check": { "file": "eboot.bin" }
  },
  "start": {
    "program": ["deception.exe", "deception"]
  },
  "prepare": {
    "program": ["deception-setup.exe", "deception-setup"],
    "args": ["--game", "{game}", "--progress"],
    "label": "The game image, built from your dump",
    "timeout": 600
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        { "path": "{install}/save/settings.ini", "if": "{install}/save/settings.ini" },
        { "path": "{install}/settings.ini" }
      ]
    }
  ],
  "saves": ["{install}/save/savedata", "{install}/save/settings.ini"],
  "folders": {
    "saves": [{ "path": "{install}/save" }],
    "logs": [{ "path": "{install}/save/log" }],
    "release": [{ "path": "{install}" }]
  },
  "settings": [
    {
      "id": "display_mode", "label": "Window",
      "help": "Borderless covers the screen at the desktop's resolution. Fullscreen takes the screen for itself. Windowed uses Window size.",
      "choices": [
        { "label": "Borderless", "set": { "display_mode": "borderless" } },
        { "label": "Fullscreen", "set": { "display_mode": "fullscreen" } },
        { "label": "Windowed", "set": { "display_mode": "windowed" } }
      ],
      "defaults": { "display_mode": "borderless" }
    },
    {
      "id": "output_resolution", "label": "Window size",
      "help": "The window's size in Windowed mode. The game draws at 1080p and is scaled to fit.",
      "choices": [
        { "label": "1280 x 720", "set": { "output_resolution": "1280x720" } },
        { "label": "1600 x 900", "set": { "output_resolution": "1600x900" } },
        { "label": "1920 x 1080", "set": { "output_resolution": "1920x1080" } },
        { "label": "2560 x 1440", "set": { "output_resolution": "2560x1440" } },
        { "label": "3840 x 2160", "set": { "output_resolution": "3840x2160" } }
      ],
      "defaults": { "output_resolution": "1920x1080", "display_mode": "borderless" },
      "when": { "display_mode": "windowed" }
    },
    {
      "id": "vsync", "label": "VSync",
      "help": "On waits for the screen's refresh. Off shows the newest frame at each refresh. The game runs at 30 FPS either way, as on PS4.",
      "choices": [
        { "label": "On", "set": { "vsync": "1" } },
        { "label": "Off", "set": { "vsync": "0" } }
      ],
      "defaults": { "vsync": "1" }
    },
    {
      "id": "tearing", "label": "Tearing",
      "help": "With VSync off, shows each frame at once: the least input delay, with tearing.",
      "choices": [
        { "label": "Off", "set": { "tearing": "0" } },
        { "label": "On", "set": { "tearing": "1" } }
      ],
      "defaults": { "tearing": "0", "vsync": "1" },
      "when": { "vsync": "0" }
    },
    {
      "id": "sharpening", "label": "Sharpening",
      "help": "AMD FSR 1 RCAS, for crisper edges as the picture is fitted to your screen. F9 switches it in the game.",
      "choices": [
        { "label": "On", "set": { "sharpening": "1" } },
        { "label": "Off", "set": { "sharpening": "0" } }
      ],
      "defaults": { "sharpening": "1" }
    },
    {
      "id": "audio_channels", "label": "Speakers",
      "help": "Automatic follows your sound device.",
      "choices": [
        { "label": "Automatic", "set": { "audio_channels": "auto" } },
        { "label": "Stereo", "set": { "audio_channels": "stereo" } },
        { "label": "5.1", "set": { "audio_channels": "5.1" } },
        { "label": "7.1", "set": { "audio_channels": "7.1" } }
      ],
      "defaults": { "audio_channels": "auto" }
    },
    {
      "id": "skip_intro", "label": "Intro",
      "help": "Skip goes past the logos, the autosave notice and \"Press ANY button\" to the title menu in about 6 seconds.",
      "choices": [
        { "label": "Skip it", "set": { "skip_intro": "1" } },
        { "label": "Play it", "set": { "skip_intro": "0" } }
      ],
      "defaults": { "skip_intro": "1" }
    }
  ],
  "looks": {
    "graphics": "vulkan"
  },
  "actions": [
    { "id": "saves", "label": "Saves", "help": "Your saves, settings and the game's log.", "open": "saves" },
    { "id": "shaders", "label": "Shader cache", "help": "Shaders the game has built, so it doesn't stutter later. Clearing only helps if graphics look wrong after an update.", "clear": "release/shaders" }
  ]
}
